# Copy this file to .env for local development (`vercel dev` reads .env
# automatically). In production, set these in the Vercel project's
# Environment Variables settings instead - never commit a real .env file.
#
# Keep a separate Stripe/Supabase project (or at least Stripe *test mode*
# + a separate signing keypair) for development vs. production - see the
# "DEVELOPMENT MODE" section of the README.

# -- Supabase --------------------------------------------------------------
# Project Settings -> API. SUPABASE_SERVICE_ROLE_KEY bypasses row-level
# security - it must only ever be set here, in this backend's server-side
# environment. Never in the desktop app, never in any browser-side code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# -- Stripe ------------------------------------------------------------------
# Developers -> API keys. Use sk_test_... / whsec_... (from `stripe
# listen`, see README) while developing; switch to the live equivalents
# only in the production environment. No price id needed - the $19.99
# price and its tax code are defined inline in api/stripe/checkout.ts.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Where Stripe Checkout sends the customer. Defaults (in code) to this
# API's own /success page and thomssen.dev - only set these if you want
# something else.
# CHECKOUT_SUCCESS_URL=https://api.thomssen.dev/success?session_id={CHECKOUT_SESSION_ID}
# CHECKOUT_CANCEL_URL=https://thomssen.dev/

# -- License token signing (Ed25519) -----------------------------------------
# Generate with: npm run generate-keypair
# LICENSE_SIGNING_PUBLIC_KEY_B64 must match the LICENSE_SIGNING_PUBLIC_KEY bytes
# embedded in thomsen-shield/src-tauri/src/license/token.rs, or the
# desktop app will reject every token this backend issues.
LICENSE_SIGNING_PRIVATE_KEY_B64=
LICENSE_SIGNING_PUBLIC_KEY_B64=

# -- Admin tool ----------------------------------------------------------------
# Generate with: npm run generate-admin-token
# Bearer token for /admin and the /api/admin/* endpoints.
ADMIN_API_TOKEN=
