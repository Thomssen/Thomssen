{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thomsen Optimizer",
  "version": "1.0.0",
  "identifier": "dev.thomssen.optimizer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Thomsen Optimizer",
        "label": "main",
        "width": 1280,
        "height": 840,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Thomsen Software",
    "copyright": "Copyright (c) 2026 Thomsen Software",
    "category": "Utility",
    "shortDescription": "Free, transparent and reversible gaming optimizer for Windows.",
    "longDescription": "Thomsen Optimizer analyses your PC, explains every possible improvement and applies only what you choose - with a full restore history. It includes a Game Booster with per-game profiles, real FPS measurement through PresentMon, a safe system cleaner and a startup manager. Free, with no accounts or ads.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Thomsen Software"
      }
    },
    "licenseFile": "installer/LICENSE.txt"
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/Thomssen/Thomsen-Optimizer/releases/latest/download/latest.json"],
      "pubkey": "",
      "windows": { "installMode": "passive" }
    }
  }
}
