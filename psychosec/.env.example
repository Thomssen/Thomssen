# ---- Backend API (services/api) : set in Vercel project "psychosec-api" -------------------------
# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Discord Developer Portal -> your application -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=                 # your PSYCHOSEC server ID (enable Developer Mode, right-click server -> Copy Server ID)
DISCORD_REQUIRED_ROLE_ID=         # optional: members must hold this role. Leave empty to require membership only
DISCORD_REDIRECT_URI=https://api.psychosec.org/api/auth/discord/callback

# Comma-separated Discord user IDs that become super administrators on first admin sign-in
ADMIN_DISCORD_IDS=

ADMIN_ORIGIN=https://admin.psychosec.org
SITE_ORIGIN=https://psychosec.org
COOKIE_DOMAIN=.psychosec.org
TRUSTED_PROXY=vercel              # vercel | none
CRON_SECRET=                      # >= 32 random chars; Vercel sends it to the retention cron

# Optional tuning (defaults shown)
SESSION_TTL_HOURS=12
SESSION_MAX_DAYS=7
ADMIN_SESSION_HOURS=8
LOGIN_IP_RETENTION_DAYS=90

# ---- Website + admin dashboard (apps/website, apps/admin) -----------------------------------------
NEXT_PUBLIC_API_URL=https://api.psychosec.org
NEXT_PUBLIC_LOGIN_IP_RETENTION_DAYS=90   # website only; keep equal to LOGIN_IP_RETENTION_DAYS

# ---- Build/release only (never commit values) ------------------------------------------------------
# PSYCHOSEC_API_URL=https://api.psychosec.org        compiled into the CLI
# PSYCHOSEC_UPDATE_PUBKEY=<base64 ed25519 public key> compiled into the CLI (scripts/release-keygen.mjs)
# RELEASE_SIGNING_KEY=<PEM>                           CI secret used by scripts/release-sign.mjs
# ABUSEIPDB_API_KEY= / HIBP_API_KEY=                  optional, read by the CLI from the user's environment
